# ─── AWS Config ───────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_PROFILE=default

# ─── Terraform ────────────────────────────────────────────────────────────────
TF_VAR_project_name=order-management
TF_VAR_environment=dev
TF_VAR_aws_region=us-east-1
TF_VAR_owner=your-name

# ─── Terraform Remote State ───────────────────────────────────────────────────
# S3 bucket and DynamoDB table for Terraform state (created separately)
TF_BACKEND_BUCKET=order-management-tfstate-<account-id>
TF_BACKEND_TABLE=order-management-tfstate-lock
TF_BACKEND_REGION=us-east-1

# ─── Lambda Runtime ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
TABLE_NAME=order-management-orders-dev
